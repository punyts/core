{
    "name": "@punyts/core",
    "version": "1.0.0",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "description": "A repository of utilities",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./logging/ConsoleLogger.js": {
            "types": "./dist/logging/ConsoleLogger.d.ts",
            "default": "./dist/logging/ConsoleLogger.js"
        },
        "./logging/FileLogger.js": {
            "types": "./dist/logging/FileLogger.d.ts",
            "default": "./dist/logging/FileLogger.js"
        },
        "./logging/Reporter.js": {
            "types": "./dist/logging/Reporter.d.ts",
            "default": "./dist/logging/Reporter.js"
        }
    },
    "scripts": {
        "clean": "bash ../../bin/clean.sh .",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "build": "npm run typecheck && bash ../../bin/build.sh . tsc -b tsconfig.build.json",
        "test": "npm run test:run",
        "test:run": "vitest run",
        "test:watch": "vitest --watch",
        "test:cov": "vitest run --coverage",
        "build:watch": "tsc -d tsconfig.build.json -w",
        "dev": "npm run build:watch"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "test": "^3.3.0"
    }
}
